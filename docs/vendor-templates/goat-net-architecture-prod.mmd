%%{init: {'theme': 'base', 'themeVariables': {'fontSize': '14px', 'lineColor': '#607d8b'}, 'flowchart': {'curve': 'basis', 'nodeSpacing': 55, 'rankSpacing': 80, 'wrappingWidth': 250, 'padding': 10}}}%%
flowchart TB
  BUNDLE["Offline-CA-signed bundle<br/>provisioned out-of-band — carries relay endpoints.<br/><b>No public DNS.</b>"]

  subgraph CLOUD["CLOUD — VPS relay tier (one box per region; two listeners, two roles)"]
    direction TB
    RWG["<b>wg-cp0 server</b> &middot; UDP 51821<br/><i>silent — drops unauthenticated handshakes</i><br/>CONTROL-plane forwarder"]
    RDR["<b>netbird data relay</b> &middot; TCP 33073<br/><i>public; blind L4 forwarder of WG-encrypted bytes</i><br/>DATA-plane P2P fallback only"]
  end

  subgraph EDGE["SOVEREIGN EDGE — Government-controlled hardware"]
    subgraph CP["control plane"]
      MGMT["Netbird management + signal<br/>at 198.18.0.1 — <i>no public listener;<br/>reached only THROUGH the cloud relay's wg-cp0</i>"]
    end
    subgraph DP["data plane — netbird mesh (100.64.0.0/10) · direct peer-to-peer · co-located peers stay on the LAN · never rides wg-cp0"]
      VENDOR["<b>YOUR SYSTEM</b><br/>enroll, then integrate via Req 1–3"]
      ZENOH["<b>Zenoh broker</b><br/>pub / sub &middot; identity-bound ACL"]
      RADAR["Sensors<br/>e.g. radar — producer"]
      C2["C2 / BMS<br/>consumer &amp; commander"]
      FUSION["Data services<br/>fusion, COP"]
      EFFECTOR["Effectors"]
    end
  end

  %% --- control plane (wg-cp0) : edges 0-2 ---
  BUNDLE -.->|provisioned to you| VENDOR
  VENDOR -.->|"enroll + mgmt / signal<br/>over wg-cp0 (UDP 51821)"| RWG
  RWG -.->|"forwards over wg-cp0 → 198.18.0.1"| MGMT

  %% --- data plane (netbird mesh, never wg-cp0) ---
  RADAR -->|publish| ZENOH
  ZENOH <--> C2
  ZENOH <--> FUSION
  VENDOR ==>|"2 — pub / sub (Req 1 / 2)"| ZENOH
  VENDOR <==>|"3 — REST / gRPC (Req 3)"| C2
  C2 -->|"REST / gRPC"| EFFECTOR
  VENDOR -.->|"P2P blocked? fallback via<br/>TCP 33073 — <b>not</b> wg-cp0"| RDR

